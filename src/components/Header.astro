---
import { navLinks, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur-md">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
		<a href="#top" class="text-lg font-extrabold tracking-tight text-text transition hover:text-primary">
			{site.name}
		</a>

		<nav class="hidden items-center gap-7 md:flex" aria-label="Principal">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class="text-sm font-medium text-muted transition hover:text-text"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2 sm:gap-3">
			<a
				href="#contact"
				class="hidden rounded-btn bg-primary px-4 py-2 text-sm font-bold text-white transition hover:bg-primary-hover lg:inline-flex"
			>
				Contacto
			</a>
			<ThemeToggle />
			<button
				type="button"
				id="menu-toggle"
				class="inline-flex size-10 items-center justify-center rounded-full border border-border bg-surface text-text md:hidden"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
				</svg>
			</button>
		</div>
	</div>

	<nav
		id="mobile-menu"
		class="hidden border-t border-border bg-bg px-4 py-4 md:hidden"
		aria-label="Móvil"
	>
		<ul class="flex flex-col gap-3">
			{
				navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class="mobile-nav-link block rounded-lg px-3 py-2 text-sm font-medium text-text transition hover:bg-primary-soft hover:text-primary"
						>
							{link.label}
						</a>
					</li>
				))
			}
			<li>
				<a
					href="#contact"
					class="mobile-nav-link block rounded-btn bg-primary px-3 py-2.5 text-center text-sm font-bold text-white"
				>
					{site.ctaPrimary}
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const btn = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	btn?.addEventListener('click', () => {
		const open = menu?.classList.toggle('hidden') === false;
		btn.setAttribute('aria-expanded', String(open));
		btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
	});

	menu?.querySelectorAll('.mobile-nav-link').forEach((link) => {
		link.addEventListener('click', () => {
			menu.classList.add('hidden');
			btn?.setAttribute('aria-expanded', 'false');
			btn?.setAttribute('aria-label', 'Abrir menú');
		});
	});
</script>
