---
import { projectFilters, projects } from '../data/site';
---

<section id="projects" class="scroll-mt-20 border-t border-border py-16 sm:py-20 lg:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center" data-reveal>
			<p class="text-sm font-semibold uppercase tracking-widest text-primary">Trabajo reciente</p>
			<h2 class="mt-2 text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
				Proyectos
			</h2>
			<p class="mt-4 text-base text-muted sm:text-lg">
				Apps, webs y experiencias digitales construidas con foco en usabilidad y código limpio.
			</p>
		</div>

		<div
			class="mt-10 flex flex-wrap items-center justify-center gap-2"
			role="group"
			aria-label="Filtrar proyectos"
			data-reveal
			style="--reveal-delay: 80ms"
		>
			{
				projectFilters.map((filter, i) => (
					<button
						type="button"
						data-filter={filter.id}
						class:list={[
							'project-filter rounded-full border px-4 py-2 text-sm font-medium transition',
							i === 0
								? 'border-primary bg-primary text-white'
								: 'border-border bg-surface text-muted hover:border-primary hover:text-primary',
						]}
					>
						{filter.label}
					</button>
				))
			}
		</div>

		<div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
			{
				projects.map((project, i) => (
					<article
						class="project-card hover-card flex flex-col overflow-hidden rounded-card border border-border bg-surface shadow-card sm:flex-row"
						data-category={project.category}
						data-reveal
						style={`--reveal-delay: ${i * 100}ms`}
					>
						<img
							src={project.image}
							alt={`Captura de ${project.title}`}
							width="640"
							height="400"
							class="aspect-video w-full object-cover sm:w-44 sm:shrink-0 sm:self-stretch sm:object-cover lg:w-52"
							loading="lazy"
						/>
						<div class="flex flex-1 flex-col p-5">
							{'result' in project && project.result && (
								<p class="text-xs font-bold uppercase tracking-wide text-primary">{project.result}</p>
							)}
							<h3 class="mt-1 text-lg font-bold text-text">{project.title}</h3>
							<p class="mt-2 text-sm leading-relaxed text-muted">{project.description}</p>
							<ul class="mt-4 flex flex-wrap gap-2">
								{project.tags.map((tag) => (
									<li class="rounded-full bg-bg px-2.5 py-1 text-xs font-medium text-muted ring-1 ring-border">
										{tag}
									</li>
								))}
							</ul>
							<div class="mt-5 flex flex-wrap gap-4">
								{'liveUrl' in project && project.liveUrl && (
									<a
										href={project.liveUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="text-sm font-bold text-primary transition hover:text-primary-hover"
									>
										Live Demo →
									</a>
								)}
								{'githubUrl' in project && project.githubUrl && (
									<a
										href={project.githubUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="text-sm font-bold text-muted transition hover:text-primary"
									>
										GitHub
									</a>
								)}
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	const filters = document.querySelectorAll<HTMLButtonElement>('.project-filter');
	const cards = document.querySelectorAll<HTMLElement>('.project-card');

	filters.forEach((btn) => {
		btn.addEventListener('click', () => {
			const value = btn.dataset.filter ?? 'all';

			filters.forEach((f) => {
				f.classList.remove('border-primary', 'bg-primary', 'text-white');
				f.classList.add('border-border', 'bg-surface', 'text-muted');
			});
			btn.classList.remove('border-border', 'bg-surface', 'text-muted');
			btn.classList.add('border-primary', 'bg-primary', 'text-white');

			cards.forEach((card) => {
				const cat = card.dataset.category;
				const show = value === 'all' || cat === value;
				card.classList.toggle('hidden', !show);
			});
		});
	});
</script>
