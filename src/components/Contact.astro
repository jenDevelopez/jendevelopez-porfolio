---
import { site } from '../data/site';

const socialPaths: Record<string, string> = {
	linkedin:
		'M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zm-9.5 14v-6H7v6h2.5zm-1.25-6.9c.8 0 1.45-.65 1.45-1.45S9.05 7.2 8.25 7.2 6.8 7.85 6.8 8.65s.65 1.45 1.45 1.45zM18 17v-3.3c0-1.75-1-2.45-2.05-2.45-.95 0-1.4.55-1.65.95V11H12v6h2.5v-3.1c0-.8.15-1.55 1.15-1.55s1.35.7 1.35 1.65V17H18z',
	github:
		'M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z',
};
---

<section id="contact" class="scroll-mt-20 border-t border-border bg-surface/50 py-16 sm:py-20 lg:py-24">
	<div class="mx-auto max-w-xl px-4 sm:px-6 lg:px-8">
		<div class="text-center" data-reveal>
			<p class="text-sm font-semibold uppercase tracking-widest text-primary">Paso siguiente</p>
			<h2 class="mt-2 text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
				Contacto
			</h2>
			<p class="mt-4 text-base text-muted sm:text-lg">
				¿Tienes un proyecto en mente? Escríbeme y te respondo lo antes posible.
			</p>
		</div>

		<a
			href={`mailto:${site.email}?subject=${encodeURIComponent('Consulta desde el portfolio')}`}
			class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-btn border border-border bg-surface px-5 py-3 text-sm font-bold text-text transition hover:border-primary hover:text-primary"
			data-reveal
			style="--reveal-delay: 80ms"
		>
			Escribir por email
		</a>

		<form
			id="contact-form"
			class="mt-8 rounded-card border border-border bg-surface p-6 shadow-card sm:p-8"
			novalidate
			data-reveal
			style="--reveal-delay: 140ms"
		>
			<p class="mb-5 text-center text-sm font-medium text-muted">O déjame tus datos aquí:</p>
			<div class="space-y-5">
				<div>
					<label for="user_name" class="mb-1.5 block text-sm font-medium text-text">Nombre</label>
					<input
						type="text"
						id="user_name"
						name="user_name"
						required
						autocomplete="name"
						placeholder="Tu nombre"
						class="w-full rounded-btn border border-border bg-bg px-4 py-2.5 text-sm text-text outline-none transition placeholder:text-muted focus:border-primary focus:ring-2 focus:ring-primary/20"
					/>
				</div>
				<div>
					<label for="user_email" class="mb-1.5 block text-sm font-medium text-text">Email</label>
					<input
						type="email"
						id="user_email"
						name="user_email"
						required
						autocomplete="email"
						placeholder="tu@email.com"
						class="w-full rounded-btn border border-border bg-bg px-4 py-2.5 text-sm text-text outline-none transition placeholder:text-muted focus:border-primary focus:ring-2 focus:ring-primary/20"
					/>
				</div>
				<div>
					<label for="message" class="mb-1.5 block text-sm font-medium text-text">Mensaje</label>
					<textarea
						id="message"
						name="message"
						required
						rows="4"
						placeholder="Cuéntame sobre tu proyecto..."
						class="w-full resize-y rounded-btn border border-border bg-bg px-4 py-2.5 text-sm text-text outline-none transition placeholder:text-muted focus:border-primary focus:ring-2 focus:ring-primary/20"
					></textarea>
				</div>
			</div>

			<button
				type="submit"
				id="contact-submit"
				class="mt-6 w-full rounded-btn bg-primary px-6 py-3.5 text-sm font-bold text-white shadow-lg shadow-primary/20 transition hover:bg-primary-hover disabled:cursor-not-allowed disabled:opacity-60"
			>
				Enviar mensaje
			</button>

			<p class="mt-3 text-center text-xs text-muted">
				Al enviar aceptas que te contacte sobre tu solicitud. Sin spam.
			</p>

			<p id="form-success" class="mt-4 hidden text-center text-sm font-medium text-primary" role="status">
				¡Mensaje enviado! Te respondo lo antes posible.
			</p>
			<p id="form-error" class="mt-4 hidden text-center text-sm font-medium text-red-600 dark:text-red-400" role="alert">
				No se pudo enviar. Inténtalo de nuevo o escríbeme por email.
			</p>
		</form>

		<p class="mt-6 text-center text-sm text-muted" data-reveal>
			📍 {site.location} ·
			<a href={`mailto:${site.email}`} class="font-medium text-primary hover:text-primary-hover">
				{site.email}
			</a>
		</p>

		<ul class="mt-8 flex items-center justify-center gap-4">
			{
				site.socials.map((social) => (
					<li>
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex size-10 items-center justify-center rounded-full border border-border bg-surface text-muted transition hover:border-primary hover:text-primary"
							aria-label={social.name}
						>
							<svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d={socialPaths[social.icon]} />
							</svg>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const success = document.getElementById('form-success');
	const errorEl = document.getElementById('form-error');
	const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;
	const endpoint = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/api/contact`;

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}

		success?.classList.add('hidden');
		errorEl?.classList.add('hidden');

		const originalLabel = submitBtn?.textContent ?? 'Enviar mensaje';
		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.textContent = 'Enviando…';
		}

		const data = new FormData(form);
		const payload = {
			name: String(data.get('user_name') ?? '').trim(),
			email: String(data.get('user_email') ?? '').trim(),
			message: String(data.get('message') ?? '').trim(),
		};

		try {
			const res = await fetch(endpoint, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(payload),
			});

			const body = (await res.json().catch(() => ({}))) as { error?: string };

			if (!res.ok) {
				throw new Error(body.error || `Error ${res.status}`);
			}

			success?.classList.remove('hidden');
			form.reset();
		} catch (err) {
			console.error('Contact form error:', err);
			if (errorEl) {
				errorEl.textContent =
					err instanceof Error && err.message
						? err.message
						: 'No se pudo enviar. Inténtalo de nuevo o escríbeme por email.';
				errorEl.classList.remove('hidden');
			}
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.textContent = originalLabel;
			}
		}
	});
</script>
