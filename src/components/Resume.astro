---
import { education, experience, site } from '../data/site';
---

<section id="resume" class="scroll-mt-20 border-t border-border bg-surface/50 py-16 sm:py-20 lg:py-24">
	<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-2xl text-center" data-reveal>
			<p class="text-sm font-semibold uppercase tracking-widest text-primary">Carrera</p>
			<h2 class="mt-2 text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
				Trayectoria
			</h2>
			<p class="mt-4 text-base text-muted sm:text-lg">
				Experiencia profesional y formación continua en desarrollo web.
			</p>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-12">
			<div data-reveal="left">
				<h3 class="text-lg font-extrabold text-text">Experiencia</h3>
				<ul class="mt-6 space-y-5">
					{
						experience.map((item) => (
							<li class="rounded-card border border-border bg-surface p-5 shadow-card">
								<div class="flex flex-wrap items-baseline justify-between gap-2">
									<p class="font-bold text-text">{item.role}</p>
									<span class="text-xs font-semibold text-primary">{item.period}</span>
								</div>
								<p class="mt-1 text-sm font-medium text-muted">{item.company}</p>
								<p class="mt-2 text-sm leading-relaxed text-muted">{item.description}</p>
							</li>
						))
					}
				</ul>
			</div>

			<div data-reveal="right" style="--reveal-delay: 100ms">
				<h3 class="text-lg font-extrabold text-text">Educación</h3>
				<ul class="mt-6 space-y-5">
					{
						education.map((item) => (
							<li class="rounded-card border border-border bg-surface p-5 shadow-card">
								<div class="flex flex-wrap items-baseline justify-between gap-2">
									<p class="font-bold text-text">{item.title}</p>
									<span class="text-xs font-semibold text-primary">{item.period}</span>
								</div>
								<p class="mt-1 text-sm text-muted">{item.place}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="mt-10 text-center" data-reveal>
			<a
				href={site.cv}
				download
				class="inline-flex items-center justify-center rounded-btn bg-primary px-7 py-3.5 text-sm font-bold text-white shadow-lg shadow-primary/25 transition hover:bg-primary-hover"
			>
				Descargar CV
			</a>
		</div>
	</div>
</section>
